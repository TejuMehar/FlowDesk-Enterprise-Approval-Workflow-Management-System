# ===================================================================
# FlowDesk Backend - Environment TEMPLATE
# -------------------------------------------------------------------
# This file is a TEMPLATE and it IS pushed to GitHub.
# Never put a real password, real connection string or real secret in
# here - put those in ".env", which is ignored by git.
#
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in your own values there
# ===================================================================

# ---- Server ----
PORT=8000
# development | production
# NODE_ENV=production switches on three things (Module 10):
#   trust proxy   so the rate limiter sees the real client IP and not
#                 the hosting platform's
#   HSTS          "only ever talk to me over https"
#   static cache  profile photos are cached by the browser for a week
# Never set it to production on a laptop: HSTS would make the browser
# refuse plain http://localhost for two years, and it cannot be undone.
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# Atlas -> Connect -> Drivers -> copy the connection string.
# Put your database name (flowdesk) before the "?".
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flowdesk

# ---- JWT ----
# Two DIFFERENT long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=put_a_long_random_string_here
JWT_REFRESH_SECRET=put_a_different_long_random_string_here

# ---- Frontend ----
# React app URL. Used for the links inside emails, and as the fallback
# CORS origin when CLIENT_URLS below is not set.
CLIENT_URL=http://localhost:5173

# ---- Extra allowed origins (Module 10, OPTIONAL) ----
# A real deployment usually has more than one legitimate frontend: the
# live site, a preview build, and localhost for whoever is debugging
# against the live API. Comma separated, no spaces needed.
# When this is set it REPLACES CLIENT_URL for CORS, so include the live
# site in the list.
# CLIENT_URLS=https://flowdesk.vercel.app,http://localhost:5173

# ---- Email (Gmail SMTP) ----
# For Gmail you MUST create an "App Password" (not your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
# If you leave these empty the app still works: the email link is simply
# printed in the backend terminal instead of being sent.
USER_EMAIL=
USER_PASSWORD=

# ---- Reminder engine (Module 6) ----
# The part of the backend that runs on its own: it nudges approvers who
# are sitting on a request, escalates the ones stuck for days, and sends
# a daily summary. Every line below is OPTIONAL - these are the defaults.
#
# While testing, set the hours to a small number (or even a fraction like
# 0.02 = ~1 minute) so you do not have to wait a day to see a reminder.
REMINDERS_ENABLED=true
REMINDER_AFTER_HOURS=24        # nudge the approver after this long
REMINDER_REPEAT_HOURS=24       # ...and again every this often
ESCALATION_AFTER_HOURS=72      # after this, tell their manager + admins
DAILY_SUMMARY_HOUR=8           # 0-23, server time
REMINDER_CHECK_MINUTES=30      # how often the engine wakes up

# ---- First Super Admin account (created by "npm run seed") ----
ADMIN_EMAIL=admin@flowdesk.com
ADMIN_PASSWORD=Admin@12345
